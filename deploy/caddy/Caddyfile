# Edge proxy for the production VM (docs/sdd/09-infrastructure-design.md section 9.5). The ARM64
# staging host does not use this file: it sits behind a Cloudflare Tunnel and runs
# Caddyfile.tunnel from the same image (ADR-018).
#
# Hosts are single labels under one zone (ADR-018): the platform console BMS_PLATFORM_HOST (for
# example bms.rincoltech.com), tenants on BMS_TENANT_HOST_PATTERN (for example
# {slug}-bms.rincoltech.com) and provider callbacks on BMS_CALLBACK_HOST. One wildcard certificate,
# *.<BMS_DNS_ZONE>, covers them all. Wildcards require the ACME DNS-01 challenge: Caddy creates a
# TXT record through the Cloudflare API with CLOUDFLARE_API_TOKEN, a token scoped to Zone.DNS:Edit
# on that zone only. Each BMS host gets its own DNS record pointing at the VM; the zone apex and
# the zone's other names are not served here. Unknown hosts reach the API and the PWA, which
# answer 404 unknown_tenant and an "unknown address" page.
# Environment: BMS_DNS_ZONE, BMS_CALLBACK_HOST, ACME_EMAIL, CLOUDFLARE_API_TOKEN (from the host .env).
{
	email {$ACME_EMAIL}
	admin off
	servers {
		# Only the proxy's own Docker network hop sits in front of the app.
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		?Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

(wildcard_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
}

*.{$BMS_DNS_ZONE} {
	import wildcard_tls
	import security_headers
	encode zstd gzip

	# Uploads are 5 MB at most (chapter 8 section 8.8); a little headroom for multipart framing.
	request_body {
		max_size 6MB
	}

	# The callback host carries provider callbacks only (chapter 7 section 7.2).
	@callbackHost host {$BMS_CALLBACK_HOST}
	handle @callbackHost {
		@callbacks path /api/v1/payments/callbacks/* /api/v1/channels/*
		handle @callbacks {
			reverse_proxy api:8080
		}
		respond 404
	}

	# The API and its health and version endpoints. The API resolves the tenant from the Host
	# header, which Caddy passes through unchanged.
	@backend path /api/* /healthz /readyz /version
	handle @backend {
		reverse_proxy api:8080
	}

	# Everything else is the PWA.
	handle {
		reverse_proxy web:8080
	}
}
