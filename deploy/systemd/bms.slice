# Hard resource cap for every BMS staging container on the shared ARM64 host (ADR-018,
# docs/sdd/09-infrastructure-design.md section 9.13). compose.pi-staging.yml places each container
# in this slice (cgroup_parent: bms.slice), so the whole stack, including the one-shot migrate
# container, never takes more than MemoryMax from the host's other workloads.
# Install: docs/runbooks/provision-host.md section 8.
[Unit]
Description=BMS staging containers (hard memory cap)
Before=slices.target

[Slice]
MemoryAccounting=yes
# Raised from 860M/900M on 24 Oct 2026 (owner decision D37) so a deploy can start the new api beside the
# old one (pending ADR-083, #496): the api peaks at about 380 MB and the stack used 790 MB of the old cap. The host
# also caps user.slice (the CI runner) at 5500M, so 1600M here still leaves the host its headroom.
MemoryHigh=1500M
MemoryMax=1600M
MemorySwapMax=0
CPUQuota=250%
