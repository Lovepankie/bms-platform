# One run of the pull-based staging deploy (ADR-018, deploy/pull-staging.sh). Started by
# bms-pull.timer; runs as the unprivileged bms user, a member of the docker group.
# Install: docs/runbooks/provision-host.md section 8.
[Unit]
Description=BMS staging: deploy the release the staging pointer names
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=bms
Group=bms
WorkingDirectory=/opt/bms
ExecStart=/opt/bms/pull-staging.sh
# The readiness gate waits longer on a Pi, where the JVM starts in about a minute.
Environment=READY_TIMEOUT=360
TimeoutStartSec=25min
# Hardening (ADR-018 finding L2): none of this bounds the root Docker socket the bms user talks to
# (docker group membership is root-equivalent on this host regardless), but it costs nothing and
# narrows what a bug in this script, as opposed to a container it starts, could do to the host.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/opt/bms
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
