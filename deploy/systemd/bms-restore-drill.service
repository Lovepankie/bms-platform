# One weekly restore drill (deploy/restore-drill.sh, NFR-BAK-04, ADR-058): restores the newest backup
# into a throwaway PostgreSQL, times it and records the result on the host and in R2.
# Runs as the bms user on staging; on production add a drop-in with User=deploy and Group=deploy.
# Install: docs/runbooks/monitoring-and-alerts.md section 2.
[Unit]
Description=BMS: weekly restore drill of the newest backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=bms
Group=bms
WorkingDirectory=/opt/bms
ExecStart=/opt/bms/restore-drill.sh
StandardOutput=append:/opt/bms/state/restore-drill.log
StandardError=append:/opt/bms/state/restore-drill.log
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/opt/bms
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
