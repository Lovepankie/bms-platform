{
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(**/.env.staging)",
      "Edit(.env.staging)",
      "Edit(**/.env.production)",
      "Edit(.env.production)",
      "Edit(**/.env.*.local)",
      "Edit(.env.*.local)",
      "Edit(**/.env.local)",
      "Edit(.env.local)",
      "Edit(secrets/**)",
      "Bash(rm -rf*)",
      "Bash(git config --global*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/surgical-change-guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-setup.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
