# Copy to terraform.tfvars (git-ignored) on the day. Placeholders only: nothing here is a real value.
# Credentials and the Cloudflare account id are NOT set here: export AWS_PROFILE, CLOUDFLARE_API_TOKEN and
# TF_VAR_cloudflare_account_id in the shell (docs/runbooks/terraform-production.md).
region          = "DECIDE_IN_THE_REGION_ADR" # NFR-DP-07, Uganda PDPO
instance_type   = "DECIDE"                   # 2 vCPU / 4 GB, for example t3.medium (x86_64) or t4g.medium (arm64)
architecture    = "x86_64"                   # arm64 for a Graviton type
r2_location     = "DECIDE"                   # weur, eeur, apac, enam, wnam or oc
ssh_public_keys = ["ssh-ed25519 AAAA... name"]
admin_cidrs     = ["203.0.113.7/32"] # documentation address, replace
tenant_slugs    = []
