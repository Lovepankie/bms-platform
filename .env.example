# Every environment variable the platform reads, with placeholders only (NFR-SEC-05).
#
#   Local development: optional. docker-compose.yml has a development default for every value it
#   uses, so a fresh clone runs without a .env. Copy this file to .env only to override one.
#   Servers: /opt/bms/.env, mode 600, owned by the deploy user (production) or the bms user (the
#   ARM64 staging host), one per environment, never shared between staging and production (docs/runbooks/provision-host.md). Never commit a filled copy.

# --- Environment -------------------------------------------------------------------------------
# staging | production. Used as the backup prefix in R2.
BMS_ENVIRONMENT=staging

# --- Hosts (chapter 7 section 7.2, ADR-018) ----------------------------------------------------
# Single labels under the rincoltech.com zone. The API and the web container read both; the API
# refuses to start if either is missing or invalid (exactly one {slug}, in the leftmost label).
# Production: {slug}-bms.rincoltech.com and bms.rincoltech.com. Local development needs neither
# (the dev profile uses {slug}.localhost and localhost).
BMS_TENANT_HOST_PATTERN={slug}-bms-staging.rincoltech.com
BMS_PLATFORM_HOST=bms-staging.rincoltech.com

# --- Images (servers) --------------------------------------------------------------------------
# The application images take IMAGE_TAG from deploy.sh; these stay pinned here.
POSTGRES_IMAGE=postgres:16.15-alpine
RCLONE_IMAGE=rclone/rclone:1.75.1

# --- Database ----------------------------------------------------------------------------------
# Superuser of the postgres container: used only by the image's first-start init scripts.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# bms_owner: owns the schema; migrations, backups, restores, onboarding scripts. Never the API.
BMS_OWNER_PASSWORD=change-me-owner
# bms_app: the API's role; NOSUPERUSER, NOBYPASSRLS, owns nothing (ADR-003).
BMS_APP_PASSWORD=change-me-app
# JDBC URL, users and pool (compose sets the URL and users on servers; listed for completeness).
# The pool is 10 on a VM and 5 on the ARM64 staging host.
BMS_DB_URL=jdbc:postgresql://postgres:5432/bms
BMS_OWNER_USER=bms_owner
BMS_APP_USER=bms_app
BMS_DB_POOL_SIZE=10

# --- API behaviour -----------------------------------------------------------------------------
# Run db-scheduler polling in this instance (ADR-008).
BMS_SCHEDULER_ENABLED=true
# Serve /api/v1/openapi.json. true on staging, false on production (chapter 7 section 7.3).
BMS_OPENAPI_ENABLED=true
# Development only; startup fails if set outside the dev and test profiles (chapter 7).
ALLOW_TENANT_HEADER=false
AUTH_MODE=none
# Internal management port (actuator health and info); never published.
BMS_MANAGEMENT_PORT=8081
# Set by the image build; shown by /version and /actuator/info.
BMS_GIT_SHA=

# Sign-in keys (ADR-014). Required outside the dev and test profiles; the API refuses to start
# without them. Generate once per environment with `java -jar bms-api.jar keys`; never reuse
# a value across environments. Losing BMS_DATA_KEY makes every enrolled TOTP secret unreadable.
BMS_TOKEN_SIGNING_JWK=
BMS_DATA_KEY=
BMS_DATA_KEY_ID=k1
# One-time links are built from BMS_TENANT_HOST_PATTERN (https://<tenant host>); there is no
# separate link origin any more.

# --- Edge proxy and TLS (production VM only) ---------------------------------------------------
# The zone the hosts sit in; Caddy serves *.<zone> with one DNS-01 wildcard certificate.
BMS_DNS_ZONE=rincoltech.com
# Provider callbacks only (chapter 7 section 7.2); staging would use bms-staging-callbacks.
BMS_CALLBACK_HOST=bms-callbacks.rincoltech.com
# ACME account e-mail for Let's Encrypt.
ACME_EMAIL=ops@bms.example
# Cloudflare API token, Zone.DNS:Edit on the zone only, for the DNS-01 challenge that issues the
# wildcard certificate (docs/sdd/09-infrastructure-design.md section 9.5).
CLOUDFLARE_API_TOKEN=change-me-cloudflare-token

# --- Cloudflare Tunnel (ARM64 staging host only, ADR-018) --------------------------------------
# cloudflared image, pinned; multi-arch.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.3
# Connector token of the staging tunnel (Zero Trust, Networks, Tunnels). A secret: it lets anyone
# run a connector for the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token

# --- Backups (servers) -------------------------------------------------------------------------
# Symmetric key for backup encryption; an offline copy is held by the dev lead (chapter 8).
BACKUP_ENCRYPTION_KEY=change-me-long-random-string
# Cloudflare R2 (S3 API): https://<account id>.r2.cloudflarestorage.com and a bucket-scoped token.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BACKUP_BUCKET=bms-backups

# --- Local development ports (docker-compose.yml) ----------------------------------------------
POSTGRES_PORT=5432
API_PORT=8080
PROXY_PORT=8000

# --- Frontend development (Vite, frontend/.env.local) ------------------------------------------
# Sent as X-Tenant by the dev server build only; unset in every production build. Staff sign in
# for real since increment 1 (ADR-014), so no development principal variables are needed.
VITE_DEV_TENANT=demo
VITE_API_PROXY=http://localhost:8080
