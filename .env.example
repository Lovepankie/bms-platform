# Every environment variable the platform reads, with placeholders only (NFR-SEC-05).
#
#   Local development: optional. docker-compose.yml has a development default for every value it
#   uses, so a fresh clone runs without a .env. Copy this file to .env only to override one.
#   Servers: /opt/bms/.env, mode 600, owned by the deploy user (production) or the bms user (the
#   ARM64 staging host), one per environment, never shared between staging and production (docs/runbooks/provision-host.md). Never commit a filled copy.

# --- Environment -------------------------------------------------------------------------------
# staging | production. Used as the backup prefix in R2, and by the SMS startup guard: outside
# production the SMS provider must be the sandbox (ADR-036).
BMS_ENVIRONMENT=staging

# --- Hosts (chapter 7 section 7.2, ADR-018) ----------------------------------------------------
# Single labels under the rincoltech.com zone. The API and the web container read both; the API
# refuses to start if either is missing or invalid (exactly one {slug}, in the leftmost label).
# Production: {slug}-bms.rincoltech.com and bms.rincoltech.com. Local development needs neither
# (the dev profile uses {slug}.localhost and localhost).
BMS_TENANT_HOST_PATTERN={slug}-bms-staging.rincoltech.com
BMS_PLATFORM_HOST=bms-staging.rincoltech.com

# --- Images (servers) --------------------------------------------------------------------------
# The application images take IMAGE_TAG from deploy.sh; these stay pinned here.
POSTGRES_IMAGE=postgres:16.15-alpine
RCLONE_IMAGE=rclone/rclone:1.75.1

# --- Database ----------------------------------------------------------------------------------
# Superuser of the postgres container: used only by the image's first-start init scripts.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# bms_owner: owns the schema; migrations, backups, restores, onboarding scripts. Never the API.
BMS_OWNER_PASSWORD=change-me-owner
# bms_app: the API's role; NOSUPERUSER, NOBYPASSRLS, owns nothing (ADR-003).
BMS_APP_PASSWORD=change-me-app
# JDBC URL, users and pool (compose sets the URL and users on servers; listed for completeness).
# The pool is 10 on a VM and 5 on the ARM64 staging host.
BMS_DB_URL=jdbc:postgresql://postgres:5432/bms
BMS_OWNER_USER=bms_owner
BMS_APP_USER=bms_app
BMS_DB_POOL_SIZE=10
# Limits every pool connection starts with (ADR-028): a statement running longer, or a transaction
# left idle longer, is ended by PostgreSQL. Defaults to 60s each when unset.
BMS_DB_STATEMENT_TIMEOUT=60s
BMS_DB_IDLE_IN_TRANSACTION_TIMEOUT=60s

# --- API behaviour -----------------------------------------------------------------------------
# Run db-scheduler polling in this instance (ADR-008).
BMS_SCHEDULER_ENABLED=true
# Serve /api/v1/openapi.json. true on staging, false on production (chapter 7 section 7.3).
BMS_OPENAPI_ENABLED=true
# Development only; startup fails if set outside the dev and test profiles (chapter 7).
ALLOW_TENANT_HEADER=false
AUTH_MODE=none
# Internal management port (actuator health and info); never published.
BMS_MANAGEMENT_PORT=8081
# Set by the image build; shown by /version and /actuator/info.
BMS_GIT_SHA=

# Sign-in keys (ADR-014). Required outside the dev and test profiles; the API refuses to start
# without them. Generate once per environment with `java -jar bms-api.jar keys`; never reuse
# a value across environments. Losing BMS_DATA_KEY makes every enrolled TOTP secret unreadable.
BMS_TOKEN_SIGNING_JWK=
BMS_DATA_KEY=
BMS_DATA_KEY_ID=k1
# One-time links are built from BMS_TENANT_HOST_PATTERN (https://<tenant host>); there is no
# separate link origin any more.

# --- Edge proxy and TLS (production VM only) ---------------------------------------------------
# The zone the hosts sit in; Caddy serves *.<zone> with one DNS-01 wildcard certificate.
BMS_DNS_ZONE=rincoltech.com
# Provider callbacks only (chapter 7 section 7.2); staging would use bms-staging-callbacks.
BMS_CALLBACK_HOST=bms-callbacks.rincoltech.com
# ACME account e-mail for Let's Encrypt.
ACME_EMAIL=ops@bms.example
# Cloudflare API token, Zone.DNS:Edit on the zone only, for the DNS-01 challenge that issues the
# wildcard certificate (docs/sdd/09-infrastructure-design.md section 9.5).
CLOUDFLARE_API_TOKEN=change-me-cloudflare-token

# --- Cloudflare Tunnel (ARM64 staging host only, ADR-018) --------------------------------------
# cloudflared image, pinned; multi-arch.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.3
# Connector token of the staging tunnel (Zero Trust, Networks, Tunnels). A secret: it lets anyone
# run a connector for the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token

# --- Backups (servers) -------------------------------------------------------------------------
# Symmetric key for backup encryption; an offline copy is held by the dev lead (chapter 8).
BACKUP_ENCRYPTION_KEY=change-me-long-random-string
# Cloudflare R2 (S3 API): https://<account id>.r2.cloudflarestorage.com and a bucket-scoped token.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BACKUP_BUCKET=bms-backups
# Documents bucket (chapter 12 section 12.5): its own bucket-scoped token, never the backup one.
R2_DOCUMENTS_ACCESS_KEY_ID=change-me
R2_DOCUMENTS_SECRET_ACCESS_KEY=change-me
R2_DOCUMENTS_BUCKET=bms-documents
# fake (dev and test profiles only) or r2. The dev profile defaults to fake.
OBJECT_STORAGE=r2

# --- Outbox senders (spec section 11, docs/runbooks/onboard-tenant.md) --------------------------
# Optional. A sender whose values are empty is off: its messages stay pending in the outbox and
# nothing fails, so local runs and tests need none of these. Email is SMTP over implicit TLS
# (port 465; 587 is blocked on the staging host). Telegram sends operator alerts to one chat.
# Left empty here on purpose: the real values live in /opt/bms/.env on the host, never in git.
# Shapes: BMS_SMTP_HOST=smtp.example.test, BMS_SMTP_USER=no-reply@example.test,
# BMS_MAIL_FROM=no-reply@example.test, BMS_TELEGRAM_BOT_TOKEN=<bot id>:<secret>,
# BMS_TELEGRAM_OPERATOR_CHAT_ID=<numeric chat id>.
BMS_SMTP_HOST=
BMS_SMTP_PORT=465
BMS_SMTP_USER=
BMS_SMTP_PASSWORD=
BMS_MAIL_FROM=
BMS_TELEGRAM_BOT_TOKEN=
BMS_TELEGRAM_OPERATOR_CHAT_ID=
# --- SMS (ADR-036, docs/runbooks/sms-setup.md) ----------------------------------------------------
# Off unless a mode and a provider are set. Secrets live in /opt/bms/.env on the host, never in git.
#   BMS_SMS_PROVIDER      africastalking | fake (the fake is for tests; production refuses it)
#   BMS_SMS_MODE          off | sink | allowlist | live. Unset is sink on staging and off elsewhere.
#                         sink records the message as sunk and sends nothing (not allowed in production);
#                         allowlist sends only to BMS_SMS_ALLOWLIST and sinks the rest; live is production only.
#   BMS_SMS_ALLOWLIST     numbers for the allowlist mode, comma separated (+256 or 07 forms)
#   BMS_SMS_PLATFORM_DAILY_CAP  most messages the platform sends in a business day, all tenants (default 2000)
#   BMS_SMS_AT_BASE_URL   Africa's Talking: https://api.sandbox.africastalking.com outside production
#   BMS_SMS_AT_USERNAME   the account: sandbox outside production
#   BMS_SMS_AT_API_KEY    the account's key
# Outside production the application refuses to start when the URL or the account is not the sandbox
# one, in every mode, and when the mode is live. In production it refuses sink and the fake.
BMS_SMS_PROVIDER=
BMS_SMS_MODE=
BMS_SMS_ALLOWLIST=
BMS_SMS_PLATFORM_DAILY_CAP=2000
# An event dated more than this many days before the tenant's today is never texted (a register being loaded).
BMS_SMS_EVENT_MAX_AGE_DAYS=3
BMS_SMS_AT_BASE_URL=
BMS_SMS_AT_USERNAME=
BMS_SMS_AT_API_KEY=

# --- Language model gateway (ADR-037, docs/runbooks/ai-assistant.md) ---------------------------
# Off unless BMS_AI_PROVIDER=openai_compatible AND the base URL, key and model are all set. An
# incomplete setting is off and logs a warning; it never fails startup. The key lives in the host
# environment only. The model name is the whole of a model swap. Shapes (invented):
# BMS_AI_BASE_URL=https://llm.example.test, BMS_AI_MODEL=example-cheap-chat. Prices are micro-units of
# the currency per million tokens, read from here and never from the repository.
BMS_AI_PROVIDER=off
BMS_AI_BASE_URL=
BMS_AI_API_KEY=
BMS_AI_MODEL=
# Tenant ids (UUIDs, never slugs), comma separated, that may switch the assistant on (the operator fills it once the
# provider's written terms are on file). Empty means no tenant can.
BMS_AI_ENABLED_TENANTS=

# Payment collections through Pesapal (ADR-035, docs/runbooks/payments.md). Off while no credentials are set. Outside
# production only the sandbox base URL is accepted (startup refuses any other, so staging cannot move real money); in
# production the sandbox and the fake are refused. Placeholders only: the values live in the host environment file.
BMS_PESAPAL_PROVIDER=
BMS_PESAPAL_BASE_URL=
BMS_PESAPAL_CONSUMER_KEY=
BMS_PESAPAL_CONSUMER_SECRET=
# The registration of this credential pair and the random path token (24 to 128 letters, digits, - or _) of its notification url.
BMS_PESAPAL_IPN_ID=
BMS_PESAPAL_IPN_TOKEN=
# The one tenant id the merchant account is bound to; every other tenant is refused when it switches collections on.
BMS_PESAPAL_TENANT_ID=
# Public https origin of the callback host, for example https://callbacks.example.org
BMS_PESAPAL_CALLBACK_BASE_URL=
BMS_PESAPAL_PLATFORM_CONSUMER_KEY=
BMS_PESAPAL_PLATFORM_CONSUMER_SECRET=
BMS_PESAPAL_PLATFORM_IPN_ID=
BMS_PESAPAL_PLATFORM_IPN_TOKEN=
# Platform daily ceilings for all tenants together (tokens, and estimated cost in micro-units).
BMS_AI_PLATFORM_DAILY_TOKENS=200000
BMS_AI_PLATFORM_DAILY_COST_MICRO=2000000
BMS_AI_PRICE_INPUT_MICRO_PER_MILLION=0
BMS_AI_PRICE_OUTPUT_MICRO_PER_MILLION=0
BMS_AI_PRICE_CURRENCY=USD
# Optional tuning, empty means the application's default (20000 and 500000 per tenant per day, 30 seconds, 800 output and
# 8000 input tokens per call). A daily cap of 0 stops every call; a negative one, or a per call limit of 0, fails startup.
BMS_AI_TENANT_DAILY_TOKENS=
BMS_AI_TENANT_DAILY_COST_MICRO=
BMS_AI_BUDGET_SECONDS=
BMS_AI_MAX_TOKENS_PER_CALL=
BMS_AI_MAX_INPUT_TOKENS_PER_CALL=
# Global sign-up caps per hour (chapter 7 section 7.10): over a cap a sign-up is answered but
# nothing is created or sent, and the operator gets one Telegram alert for the hour.
BMS_SIGNUP_MAX_APPLICATIONS_PER_HOUR=30
BMS_SIGNUP_MAX_VERIFICATION_EMAILS_PER_HOUR=60

# Report runs (ADR-038, issue #214). Not secrets. Production defaults are shown; the Pi staging host sets 1 concurrent run,
# a 20000 row table cap, a 500 row PDF cap and an 8 MiB file cap, because its API has about 224 MB of heap.
# BMS_REPORTS_XLSX_ROW_CAP is the row cap of every tabular output (Excel sheet, CSV, JSON);
# BMS_REPORTS_PDF_ROW_CAP cuts a longer PDF table to that many rows (its total row is kept) with a pointer to the Excel file.
BMS_REPORTS_MAX_CONCURRENT_RUNS=2
BMS_REPORTS_XLSX_ROW_CAP=200000
BMS_REPORTS_PDF_ROW_CAP=3000
BMS_REPORTS_MAX_FILE_BYTES=67108864
# Empty: a folder in the container's temp directory. A run's spool files are removed when it ends.
BMS_REPORTS_SPOOL_DIR=

# --- Local development ports (docker-compose.yml) ----------------------------------------------
POSTGRES_PORT=5432
API_PORT=8080
PROXY_PORT=8000

# --- Frontend development (Vite, frontend/.env.local) ------------------------------------------
# Sent as X-Tenant by the dev server build only; unset in every production build. Staff sign in
# for real since increment 1 (ADR-014), so no development principal variables are needed.
VITE_DEV_TENANT=demo
VITE_API_PROXY=http://localhost:8080
